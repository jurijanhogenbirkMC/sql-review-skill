-- hoeveel van de seh visits hebben een opname gehad in opname tabel per herkomst
SELECT s.herkomst_cat,
       COUNT(s.sehid) AS seh_visits,
       SUM(CASE WHEN o.opnamenr IS NOT NULL THEN 1 ELSE 0 END) AS admitted_count
FROM msd_tables.seh_brontabel s
LEFT JOIN msd_tables.opname_brontabel o
  ON s.patientnr = o.patientnr
  AND o.datum_opname = s.datum_aankomst 
GROUP BY s.herkomst_cat
ORDER BY admitted_count DESC;

--- dbc per postcode
SELECT pk.jaar AS [Year],
       pk.postcode4 AS pc4,
       pd.gemeente AS gemeente,
       COUNT(*) AS record_count,
       SUM(ISNULL(d.bedrag_verr_extra,0)) AS total_bedrag
FROM msd_tables.dbc_brontabel d
JOIN msd_tables.patientkenmerken_historisch pk
  ON d.patientnr = pk.patientnr
  AND d.jaar_datum_verr = pk.jaar
LEFT JOIN msd_dim.postcode4 pd
  ON pk.postcode4 = pd.pc4
GROUP BY pk.jaar, pk.postcode4, pd.gemeente
ORDER BY pk.jaar, total_bedrag DESC;

--- kosten per verrichting en gewogen prijzen per verrichting
SELECT d.declcode_aangepast,
       COUNT(d.casenr) AS cnt,
       AVG(ISNULL(d.bedrag_verr_extra,0)) AS avg_bedrag,
       gp.gewogen_prijs_per_verr_2023 AS prijs_2023,
       gp.gemiddeld_prijs_meerjaren AS avg_multi_year_price
FROM msd_tables.dbc_brontabel d
LEFT JOIN msd_dim.gewogen_prijs_per_verr gp
  ON d.declcode_aangepast = gp.declcode_aangepast
GROUP BY d.declcode_aangepast, gp.gewogen_prijs_per_verr_2023, gp.gemiddeld_prijs_meerjaren
ORDER BY cnt DESC

