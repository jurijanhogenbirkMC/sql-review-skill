use Marktstrategie_prd

/*
Purpose: Exploratory analyses of DBC activity, hospital admissions, radiology,
         emergency visits, referrals, and procedure costs.
Database: Marktstrategie_prd
Sources:  msd_tables contains activity and patient-related tables;
         msd_dim contains descriptive and pricing dimensions.
Output:   Each SELECT returns a separate result set. This script does not
          create or modify database objects.

Interpretation notes:
- Queries have different grains (patient, visit, admission, postcode/year,
  or procedure code); do not compare their counts without checking the grain.
- Joins can multiply rows when the joined key is not unique. Check key
  cardinality before trusting counts, sums, or averages.
- Date boundaries, NULL handling, and category definitions should be checked
  against the applicable business rules before using results for reporting.
- TOP queries without ORDER BY return an unspecified sample.
*/

-- DBC label split by year for the thoracic specialties in scope.
-- Output grain: year and derived label; patient counts are distinct within
-- each group. Confirm that a patient cannot occur in both label groups in a year.
select jaar_datum_verr as Jaar, case when rb_gelabeld_01_patient_NZA = 1 then 'Gelabeld' else 'Niet gelabeld' end as Gelabeld,count(distinct patientnr) as Aantal_patienten,count(distinct patientnr) * 100.0 / sum(count(distinct patientnr)) over (partition by jaar_datum_verr) as Percentage 
from msd_tables.dbc_brontabel
where jaar_datum_verr in (2023, 2024) AND qs_alt_specialisme_koppeldbc in ('LON', 'CAR','CTC') and indeling_verrichting = 'DBC'
group by case when rb_gelabeld_01_patient_NZA = 1 then 'Gelabeld' else 'Niet gelabeld' end, jaar_datum_verr	

-- Radiology events matched to each admission by patient and event timestamp.
-- Output grain: one row per grouped admission. COUNT uses onderznr; MIN/MAX
-- show the earliest/latest matched tijd_invoer. Verify the intended discharge
-- boundary and whether events can match more than one admission.
SELECT o.opnamenr,
       o.patientnr,
       o.datum_opname,
       o.datum_ontslag,
       COUNT(r.onderznr) AS radiology_count,
       MIN(r.tijd_invoer) AS first_rad_in_admission,
       MAX(r.tijd_invoer) AS last_rad_in_admission
FROM msd_tables.opname_brontabel o
LEFT JOIN msd_tables.radiologie_brontabel r
  ON r.patientnr = o.patientnr
  AND r.tijd_invoer >= o.datum_opname
  AND r.tijd_invoer <= DATEADD(day,1,CAST(o.datum_ontslag AS datetime))
GROUP BY o.opnamenr, o.patientnr, o.datum_opname, o.datum_ontslag
ORDER BY o.datum_opname DESC;

-- Unordered TOP samples for inspecting source columns and example records.
-- These are exploratory only; TOP without ORDER BY is not a reproducible sample.
select top(100) * from msd_tables.seh_brontabel
select top(100) * from msd_tables.opname_brontabel
select top(100) * from msd_tables.radiologie_brontabel
select top (1000) * from msd_dim.verwijzers_correctie
select top(100) * from msd_tables.dbc_brontabel

-- SEH visit and same-day admission counts grouped by origin category.
-- Intended output grain: herkomst_cat. Multiple admission matches for one
-- visit can multiply both aggregates; confirm visit/admission key uniqueness.
SELECT s.herkomst_cat,
       COUNT(s.sehid) AS seh_visits,
       SUM(CASE WHEN o.opnamenr IS NOT NULL THEN 1 ELSE 0 END) AS admitted_count
FROM msd_tables.seh_brontabel s
LEFT JOIN msd_tables.opname_brontabel o
  ON s.patientnr = o.patientnr
  AND o.datum_opname = s.datum_aankomst 
GROUP BY s.herkomst_cat
ORDER BY admitted_count DESC;

-- DBC records and recorded amounts by patient postcode and year.
-- Patient characteristics are matched on patient and year; postcode4 is
-- translated to gemeente through the postcode dimension. Confirm each join
-- returns at most one matching row, since duplicate matches inflate totals.
-- NULL bedragen are treated as zero in total_bedrag.
SELECT pk.jaar AS [Year],
       pk.postcode4 AS pc4,
       pd.gemeente AS gemeente,
       COUNT(*) AS record_count,
       SUM(ISNULL(d.bedrag_verr_extra,0)) AS total_bedrag
FROM msd_tables.dbc_brontabel d
JOIN msd_tables.patientkenmerken_historisch pk
  ON d.patientnr = pk.patientnr
  AND d.jaar_datum_verr = pk.jaar
LEFT JOIN msd_dim.postcode4 pd
  ON pk.postcode4 = pd.pc4
GROUP BY pk.jaar, pk.postcode4, pd.gemeente
ORDER BY pk.jaar, total_bedrag DESC;

-- DBC counts and average recorded amount by adjusted procedure code, alongside
-- reference prices from the weighted-price dimension. Confirm that the price
-- dimension has one row per code. NULL amounts are treated as zero in AVG.
SELECT d.declcode_aangepast,
       COUNT(d.casenr) AS cnt,
       AVG(ISNULL(d.bedrag_verr_extra,0)) AS avg_bedrag,
       gp.gewogen_prijs_per_verr_2023 AS prijs_2023,
       gp.gemiddeld_prijs_meerjaren AS avg_multi_year_price
FROM msd_tables.dbc_brontabel d
LEFT JOIN msd_dim.gewogen_prijs_per_verr gp
  ON d.declcode_aangepast = gp.declcode_aangepast
GROUP BY d.declcode_aangepast, gp.gewogen_prijs_per_verr_2023, gp.gemiddeld_prijs_meerjaren
ORDER BY cnt DESC

-- Pediatric specialty exploration: kin and klg are the specialty codes in scope.
-- The TOP result is only an unordered sample; the count below is distinct patients.
select top(100) * from msd_tables.dbc_brontabel where qs_alt_specialisme_koppeldbc in ('kin', 'klg')

select count(distinct patientnr) from msd_tables.dbc_brontabel where qs_alt_specialisme_koppeldbc in ('kin', 'klg')

-- Distinct patients by subspecialisme_dbc within the selected specialties.
-- This query does not replace blank or NULL subspecialty values with a fallback.
select subspecialisme_dbc, count(distinct patientnr) as Aantal_patienten from msd_tables.dbc_brontabel 
where qs_alt_specialisme_koppeldbc in ('kin', 'klg') 
group by subspecialisme_dbc order by Aantal_patienten desc

-- Distinct pediatric patients meeting the label and multispecialism filters.
-- The categories 3, 4, and 5+ are treated as the selected threshold groups.
-- 27.796
select count(distinct patientnr) as Aantal_patienten from msd_tables.dbc_brontabel 
where qs_alt_specialisme_koppeldbc in ('kin', 'klg') and rb_gelabeld_01_patient_NZA = 1 and multispecialistisch_cat in ('3', '4', '5+')

-- Distinct patients grouped by referral description and resolved specialty.
-- Empty subspecialisme_dbc values fall back to specialisme_dbc; NULL values
-- are not replaced by NULLIF. The poli_aantal condition is != 0, although the
-- original note says > 1; confirm which rule is intended. ligdagen = 0 is used
-- as the no-admission criterion for this analysis.
select v.[Verwijstype omschrijving], COALESCE(NULLIF(d.subspecialisme_dbc, ''), d.specialisme_dbc) as subspecialisme_dbc,  count(distinct patientnr) as Aantal_patienten 
from msd_tables.dbc_brontabel d
left join msd_dim.Verwijstype as v on d.type_verwijzer = v.Verwijstype
where qs_alt_specialisme_koppeldbc in ('kin', 'klg') and 
rb_gelabeld_01_patient_NZA = 1 and 
multispecialistisch_cat in ('3', '4', '5+') and 
poli_aantal != 0 and --- > 1 poli bezoek gehad 
ligdagen_totaal_aantal = 0 -- geen opname gehad
group by v.[Verwijstype omschrijving], COALESCE(NULLIF(d.subspecialisme_dbc, ''), d.specialisme_dbc) order by Aantal_patienten desc


-- Pediatric cohort admissions with an operation recorded on the admission date.
-- Reports distinct patients and average admission-to-discharge day difference.
-- Multiple linked operation rows can repeat an admission in the AVG. The OK
-- predicates in WHERE also mean an unmatched LEFT JOIN row is excluded.
select count(distinct o.patientnr) as Aantal_patienten, AVG(DATEDIFF(day, o.datum_opname, o.datum_ontslag)) as Gemiddelde_opnameduur
from msd_tables.opname_brontabel o
left join msd_tables.opname_koppeltabel okk on o.opnamenr = okk.opnamenr
left join msd_tables.ok_brontabel ok on okk.opnamenr = ok.opnamenr
where o.patientnr in (select distinct patientnr from msd_tables.dbc_brontabel where qs_alt_specialisme_koppeldbc in ('kin', 'klg') and rb_gelabeld_01_patient_NZA = 1 and multispecialistisch_cat in ('3', '4', '5+')) 
and o.datum_opname = ok.operatie_datum 

-- Pediatric cohort admissions that started before a linked operation date.
-- The DATEDIFF below measures days from admission to operation, not total
-- admission duration. Confirm whether operations must fall within the same
-- admission and how multiple operations per admission should be handled.
select count(distinct o.patientnr) as Aantal_patienten, AVG(DATEDIFF(day, o.datum_opname, ok.operatie_datum)) as Gemiddelde_opnameduur
from msd_tables.opname_brontabel o
left join msd_tables.opname_koppeltabel okk on o.opnamenr = okk.opnamenr
left join msd_tables.ok_brontabel ok on okk.opnamenr = ok.opnamenr
where o.patientnr in (select distinct patientnr from msd_tables.dbc_brontabel where qs_alt_specialisme_koppeldbc in ('kin', 'klg') and rb_gelabeld_01_patient_NZA = 1 and multispecialistisch_cat in ('3', '4', '5+'))
and o.datum_opname < ok.operatie_datum 

