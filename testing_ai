
/*Nieuwe opzet*/ 
--setting up the patient kenmerken tabel met historische data

/*1. Selectie van jaarrange*/
DECLARE @MinYear INT = 2017;
DECLARE @MaxYear INT = 2026;

DROP TABLE IF EXISTS #years;
CREATE TABLE #years (
    jaar INT,
    peildatum DATE,
    startdatum DATE,
    einddatum DATE
);

DECLARE @Year INT = @MinYear;

WHILE @Year <= @MaxYear
BEGIN
    INSERT INTO #years
    SELECT 
        @Year,
        DATEFROMPARTS(@Year, 7, 1),
        DATEFROMPARTS(@Year, 1, 1),
        DATEFROMPARTS(@Year + 1, 1, 1);

    SET @Year = @Year + 1;
END;

-- check
SELECT * FROM #years ORDER BY jaar;

/*2. Brontabel maken*/

/*Stap 2.0: Selecteren van relevante variabelen uit de HIX brontabel*/ 
DROP TABLE IF EXISTS #patient_historie_totaal_hist
SELECT distinct 
PATIENTNR
,GESLACHT
,cast(GEBDAT as date) gebdat
--,GEBPLAATS
,cast(INGANGSDAT as date) ingangsdat
,OVERLEDEN
,cast(OVERLDAT as date) overldat
,cast(MUTDAT as date) mutdat
,ADRES
,HUISNR
,POSTCODE
,SUBSTRING(POSTCODE,1,4) as postcode4
,WOONPLAATS
,LAND
,PARTVERZ
--,AANVVERZ
,'Obv originele afleiding patient_pathist' as categorie_afleiding
  INTO #patient_historie_totaal_hist
  FROM [ZA_PM_HIX].[HIX_PRODUCTIE].[dbo].[PATIENT_PATHIST] 
  WHERE ingangsdat IS NOT NULL /*later toegevoegd, bijvoorbeeld obv patientnr 0125645*/ or mutdat is not null

